{
  // Configuración del Worker que publica bolanosnavarro.com (Cloudflare Workers Builds la usa en cada push a main)
  "name": "bolanosnavarro",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  // Conserva variables creadas en el panel de Cloudflare (ADMIN_KEY va como Secret y nunca en este archivo)
  "keep_vars": true,
  "routes": [{ "pattern": "bolanosnavarro.com", "custom_domain": true }],
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "testimonios", "database_id": "d21f0720-6519-4a60-a4e0-851a78484205" }
  ]
}
